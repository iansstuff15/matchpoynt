{
  "name": "matchpoynt",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:(web|api)$/\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b && pnpm --filter @matchpoynt/server typecheck && pnpm --filter @matchpoynt/test typecheck",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "ui:add": "node scripts/shadcn-add.mjs",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "desktop:icons": "tauri icon public/favicon.svg",
    "dev:api": "pnpm --filter @matchpoynt/server dev",
    "test": "node scripts/test-all.mjs",
    "email:templates": "node scripts/email-templates.mjs",
    "db:generate": "pnpm --filter @matchpoynt/server db:generate",
    "db:migrate": "pnpm --filter @matchpoynt/server db:migrate",
    "dev:web": "vite",
    "test:unit": "node scripts/test-all.mjs --only=unit",
    "test:ui": "node scripts/test-all.mjs --only=ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@matchpoynt/shared": "workspace:*",
    "@tanstack/query-sync-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "simple-icons": "^16.37.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "description": "Multi-sport court session app: fair queues, court assignment, scores, fees and rankings.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  }
}
