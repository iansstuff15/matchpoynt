# Copy to .env and fill in. Never commit .env.
# Everything here is read by the API (server/) or by migrations. The web app
# and desktop bundle get nothing from this file: no VITE_ variables.

# --- API ---
# Supabase project URL and publishable (anon) key. The API calls Supabase as
# the signed-in user (their Firebase token, through Supabase third-party auth),
# so RLS applies. No service-role key is used anywhere.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Public origin of the website (OAuth redirects and CSRF origin checks).
APP_URL=http://localhost:1420
API_PORT=8787
# Firebase Auth: accounts, sign-in (email, email links, Google) and guests.
# The API calls Firebase's REST API and keeps tokens in httpOnly cookies; the
# browser never loads Firebase. From Firebase console > Project settings >
# General > Your apps (the web app's config).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Service account (Project settings > Service accounts > Generate new private key):
# client_email and private_key from the JSON, the key in quotes with its \n escapes.
# Used only to give accounts the `role: authenticated` claim Supabase needs, to
# find the account an email or username belongs to, and to make the codes for
# the emailed links the API sends.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Outgoing email, through Resend (resend.com > API Keys). The API sends password
# resets, email confirmations, links to a new sign-in email and club invites itself,
# with Matchpoynt's templates; Firebase only makes the links' codes.
RESEND_API_KEY=
# Who emails are from: an address on a domain verified in Resend. Left empty, it's
# Resend's test sender, which only delivers to your own Resend account's email.
EMAIL_FROM=
# Optional: where replies go.
EMAIL_REPLY_TO=
# GIPHY API key (developers.giphy.com), for searching GIFs as club badge icons.
# Only needed with FEATURE_WEB_GIF_SEARCH=true; the API refuses to start without it then.
GIPHY_API_KEY=

# --- Feature toggles (true/false). Unset uses the default in shared/src/config/features.ts ---
# FEATURE_WEB_RANKINGS=true
# FEATURE_WEB_SIGN_IN=true
# FEATURE_WEB_SIGN_IN_GOOGLE=true
# Needs the Apple provider set up in Firebase first.
# FEATURE_WEB_SIGN_IN_APPLE=false
# FEATURE_WEB_SIGN_IN_EMAIL=true
# FEATURE_WEB_SIGN_UP=true
# FEATURE_WEB_PASSWORD_RESET=true
# FEATURE_WEB_DESKTOP_DOWNLOAD=false
# FEATURE_WEB_PUBLISH_SESSIONS=true
# Club manager: clubs, member rosters, planned sessions and photos (needs the club-media bucket from the migrations).
# FEATURE_WEB_CLUBS=true
# Tournament play on courts (court switch, Tournament tab), and its public /t/<slug> pages.
# FEATURE_WEB_TOURNAMENTS=true
# FEATURE_WEB_PUBLISH_TOURNAMENTS=true
# Clubs' own badges with conditions and GIF or image icons (needs clubs), and GIPHY search for their icons (needs GIPHY_API_KEY).
# FEATURE_WEB_CLUB_BADGES=true
# FEATURE_WEB_GIF_SEARCH=false
# Joining fees (session setup, club fee schemes), invoices when a session ends and the Invoices page.
# FEATURE_WEB_FEES=true
# Club billers, expenses (club-wide and per session) and the accounting dashboard (needs clubs).
# FEATURE_WEB_ACCOUNTING=true
# The club directory, join requests and join pages (QR), in-app invites and session requests (needs clubs and sign-in).
# FEATURE_WEB_CLUB_DIRECTORY=true
# Players' live view of a running club session they're in: their wait, courts, up next and the queue (needs clubs, sign-in and the directory).
# FEATURE_WEB_PLAYER_VIEW=true
# Clubs' post-session feedback form, built by owners and answered by members (needs clubs; answering needs sign-in and the directory).
# FEATURE_WEB_CLUB_FEEDBACK=true
# Club announcements, posted by owners and read by members on the club's page (needs clubs; reading needs sign-in and the directory).
# FEATURE_WEB_CLUB_ANNOUNCEMENTS=true
# Friends: adding people, requests and the Friends page (needs sign-in).
# FEATURE_WEB_FRIENDS=true
# FEATURE_WEB_SPLASH=true
# FEATURE_DESKTOP_OFFLINE_MODE=false
# FEATURE_DESKTOP_AUTO_UPDATE=false

# --- Migrations only (pnpm db:migrate). Supabase > Connect > Session pooler. ---
DATABASE_URL=

# --- Docker Compose ---
PROXY_PORT=8080
MATCHPOYNT_LOG_DIR=./logs
# MATCHPOYNT_WEB_IMAGE=registry.example.com/matchpoynt-web:0.1.0
# MATCHPOYNT_API_IMAGE=registry.example.com/matchpoynt-api:0.1.0
# MATCHPOYNT_PROXY_IMAGE=registry.example.com/matchpoynt-proxy:0.1.0
